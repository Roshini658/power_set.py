def powerSet(nums):
    n = len(nums)  # number of elements
    result = []  # to store all subsets

    # loop from 0 to 2^n - 1
    for i in range(1 << n):

        subset = []  # current subset

        # check every bit
        for j in range(n):

            # if j-th bit is set
            if i & (1 << j):
                subset.append(nums[j])

        result.append(subset)  # store subset

    return result
